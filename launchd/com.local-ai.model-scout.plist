<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local-ai.model-scout</string>
  <!-- Checks every 30 minutes; the script runs once a month, overnight
       (00:00-06:00) or when the Mac is on power and idle for 15+ minutes.
       It asks first (no answer in 10 minutes = run) and pauses if you come back. caffeinate keeps the Mac awake only while it runs. -->
  <key>ProgramArguments</key>
  <array>
    <string>__PY__</string>
    <string>__REPO__/scout/scout.py</string>
    <string>auto</string>
  </array>
  <key>StandardOutPath</key>
  <string>__HOME__/logs/scout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/logs/scout.log</string>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
