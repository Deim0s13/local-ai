<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local-ai.model-scout</string>
  <!-- Fires nightly at 02:00; the script runs the check once a month and only
       between 00:00 and 06:00. A run missed while asleep fires on wake, and then
       only reminds you (from day 7) instead of tying up the Mac while you work. -->
  <key>ProgramArguments</key>
  <array>
    <string>__PY__</string>
    <string>__REPO__/scout/scout.py</string>
    <string>auto</string>
  </array>
  <key>StandardOutPath</key>
  <string>__HOME__/logs/scout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/logs/scout.log</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
