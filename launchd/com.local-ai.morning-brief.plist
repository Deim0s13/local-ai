<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local-ai.morning-brief</string>
  <!-- 09:30 on weekdays (the script skips Sat and Sun), alongside the brew job (the brief waits for brew to finish
       so it can list anything that needs you). If the Mac is asleep, it runs
       on wake; it only builds one brief per day. -->
  <key>ProgramArguments</key>
  <array>
    <string>__PY__</string>
    <string>__REPO__/brief/brief.py</string>
    <string>auto</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/logs/brief.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/logs/brief.log</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
